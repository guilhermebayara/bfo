{
  "$schema": "node_modules/wrangler/config-schema.json",

  // Um Worker para produção e prévias. O domínio próprio serve a produção
  // e habilita subdomínios por branch. Os endereços workers.dev ficam desligados.
  "name": "bfo",
  "main": "src/server/index.ts",
  "compatibility_date": "2026-11-19",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "bfo.bayara.design",
      "custom_domain": true,
      "previews_enabled": true,
    },
  ],

  // O Worker atende a API e serve o front compilado, com fallback para o React.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },

  // O backup roda só em produção, às 03h em America/Sao_Paulo (06h UTC).
  "triggers": { "crons": ["0 6 * * *"] },
  "r2_buckets": [{ "binding": "BACKUPS", "bucket_name": "bfo-backups" }],

  // A API usa DB em produção. O segundo binding fica reservado ao backup.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bfo-producao",
      "database_id": "32c0ee02-7cdf-4fc7-b83f-e8808ba3f4de",
      "migrations_dir": "migrations",
    },
    {
      "binding": "BACKUP_DB_HOMOLOGACAO",
      "database_name": "bfo-homologacao",
      "database_id": "9db4bc67-bacb-4176-8701-34d24f7c7bce",
      "migrations_dir": "migrations",
    },
  ],

  // Nas prévias, DB aponta para o banco compartilhado de teste.
  // Só o endereço de homologação usa o binding DB_HOMOLOGACAO.
  "previews": {
    "d1_databases": [
      {
        "binding": "DB",
        "database_name": "bfo-teste",
        "database_id": "12a118f5-0f36-46b7-83b0-97a5881bda5c",
        "migrations_dir": "migrations",
      },
      {
        "binding": "DB_HOMOLOGACAO",
        "database_name": "bfo-homologacao",
        "database_id": "9db4bc67-bacb-4176-8701-34d24f7c7bce",
        "migrations_dir": "migrations",
      },
    ],
  },
}
